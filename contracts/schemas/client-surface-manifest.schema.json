{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:client-surface-manifest:0.1.0",
  "title": "Kumwe extension client-surface manifest proposal",
  "description": "A closed, bounded, non-executable proposal for extension-owned semantic client surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "manifest_id",
    "owner",
    "runtime",
    "required_contracts",
    "surfaces"
  ],
  "properties": {
    "$schema": {
      "const": "urn:kumwe:proposal:schema:client-surface-manifest:0.1.0"
    },
    "schema_version": {
      "const": 1
    },
    "manifest_id": {
      "$ref": "#/$defs/namespacedId"
    },
    "owner": {
      "$ref": "#/$defs/owner"
    },
    "runtime": {
      "$ref": "#/$defs/runtime"
    },
    "required_contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/contractRequirement"
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/surface"
      }
    }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+){2,}$",
      "maxLength": 191
    },
    "handle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 191
    },
    "localHandle": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 120
    },
    "capability": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 191
    },
    "checksum": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "maxLength": 80
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "translations": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {
            "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$",
            "maxLength": 35
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extension", "version", "checksum"],
      "properties": {
        "extension": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}/[a-z][a-z0-9-]{0,62}$",
          "maxLength": 127
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "checksum"],
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        }
      }
    },
    "contractRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version_range"],
      "properties": {
        "id": {
          "$ref": "#/$defs/handle"
        },
        "version_range": {
          "type": "string",
          "pattern": "^[0-9A-Za-z^~<>=.*+| ,_-]{1,80}$",
          "maxLength": 80
        }
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/capability"
      }
    },
    "requiredOperations": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "discover",
          "browse",
          "read",
          "create",
          "update",
          "delete",
          "archive",
          "restore",
          "history",
          "action",
          "relation",
          "approval",
          "report"
        ]
      }
    },
    "fieldPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["widget"],
      "properties": {
        "widget": {
          "enum": [
            "text",
            "multiline_text",
            "rich_text",
            "integer",
            "decimal",
            "money",
            "quantity",
            "boolean",
            "choice",
            "date",
            "time",
            "instant",
            "email",
            "url",
            "phone",
            "media_reference",
            "entity_reference",
            "object",
            "collection",
            "secret",
            "output"
          ]
        },
        "emphasis": {
          "enum": ["normal", "primary", "secondary"]
        },
        "width": {
          "enum": ["full", "half", "third"]
        }
      }
    },
    "fieldPresentations": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/localHandle"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fieldPresentation"
      }
    },
    "navigationItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "screen", "order", "required_capabilities"],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "screen": {
          "$ref": "#/$defs/namespacedId"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "icon": {
          "enum": [
            "home",
            "records",
            "document",
            "report",
            "settings",
            "people",
            "calendar",
            "inventory",
            "money",
            "task",
            "search"
          ]
        },
        "required_capabilities": {
          "$ref": "#/$defs/requiredCapabilities"
        }
      }
    },
    "screen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "order", "required_capabilities", "required_operations"],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "kind": {
          "enum": ["collection", "record", "form", "document", "report"]
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "required_capabilities": {
          "$ref": "#/$defs/requiredCapabilities"
        },
        "required_operations": {
          "$ref": "#/$defs/requiredOperations"
        },
        "definition": {
          "$ref": "#/$defs/handle"
        },
        "view": {
          "$ref": "#/$defs/localHandle"
        },
        "mode": {
          "enum": ["create", "update"]
        },
        "report": {
          "$ref": "#/$defs/handle"
        },
        "field_presentations": {
          "$ref": "#/$defs/fieldPresentations"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "collection"}}},
          "then": {
            "required": ["definition"],
            "properties": {"mode": false, "report": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "record"}}},
          "then": {
            "required": ["definition"],
            "properties": {"view": false, "mode": false, "report": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "form"}}},
          "then": {
            "required": ["definition", "mode"],
            "properties": {"view": false, "report": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "document"}}},
          "then": {
            "required": ["definition", "view"],
            "properties": {"mode": false, "report": false}
          }
        },
        {
          "if": {"properties": {"kind": {"const": "report"}}},
          "then": {
            "required": ["report"],
            "properties": {
              "definition": false,
              "view": false,
              "mode": false,
              "field_presentations": false
            }
          }
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "audience",
        "kind",
        "label",
        "order",
        "required_capabilities",
        "unsupported_behavior",
        "navigation",
        "screens"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/namespacedId"
        },
        "audience": {
          "enum": ["administrator", "portal"]
        },
        "kind": {
          "enum": ["workspace", "module"]
        },
        "label": {
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "$ref": "#/$defs/localizedText"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "required_capabilities": {
          "$ref": "#/$defs/requiredCapabilities"
        },
        "unsupported_behavior": {
          "enum": ["hide", "show_unavailable"]
        },
        "navigation": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/navigationItem"
          }
        },
        "screens": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/screen"
          }
        }
      }
    }
  }
}
