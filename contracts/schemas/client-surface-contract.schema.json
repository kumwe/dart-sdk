{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:client-surface-contract:0.1.0",
  "title": "Kumwe client-surface contract proposal schema",
  "description": "Validates the non-authoritative vocabulary and limit profile for extension client surfaces.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "proposal_id",
    "proposal_version",
    "status",
    "authoritative",
    "manifest_schema",
    "purpose",
    "limits",
    "vocabulary",
    "security_invariants",
    "adoption_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "proposal_id": {
      "const": "kumwe.client-surface.contract"
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+-proposal\\.[1-9][0-9]*$",
      "maxLength": 40
    },
    "status": {
      "const": "proposal"
    },
    "authoritative": {
      "const": false
    },
    "manifest_schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "limits": {
      "$ref": "#/$defs/limits"
    },
    "vocabulary": {
      "$ref": "#/$defs/vocabulary"
    },
    "security_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "adoption_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CORE-[A-Z]+-[0-9]{3}$",
        "maxLength": 40
      }
    }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoded_bytes",
        "surfaces",
        "navigation_items_per_surface",
        "screens_per_surface",
        "required_contracts",
        "required_capabilities_per_item",
        "field_presentations_per_screen",
        "translations_per_label",
        "string_bytes"
      ],
      "properties": {
        "encoded_bytes": {"const": 1048576},
        "surfaces": {"const": 64},
        "navigation_items_per_surface": {"const": 128},
        "screens_per_surface": {"const": 256},
        "required_contracts": {"const": 16},
        "required_capabilities_per_item": {"const": 32},
        "field_presentations_per_screen": {"const": 64},
        "translations_per_label": {"const": 16},
        "string_bytes": {"const": 2048}
      }
    },
    "boundedVocabulary": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$",
        "maxLength": 64
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audiences", "surface_kinds", "screen_kinds", "widgets", "business_operations"],
      "properties": {
        "audiences": {"$ref": "#/$defs/boundedVocabulary"},
        "surface_kinds": {"$ref": "#/$defs/boundedVocabulary"},
        "screen_kinds": {"$ref": "#/$defs/boundedVocabulary"},
        "widgets": {"$ref": "#/$defs/boundedVocabulary"},
        "business_operations": {"$ref": "#/$defs/boundedVocabulary"}
      }
    }
  }
}
