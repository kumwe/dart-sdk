{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:collection-pagination:0.1.1",
  "title": "Kumwe uniform collection pagination proposal schema",
  "description": "Validates the non-authoritative proposal extending the observed opaque-cursor collection envelope to every management collection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "proposal_id",
    "proposal_version",
    "status",
    "authoritative",
    "audited_core",
    "purpose",
    "envelope",
    "limits",
    "collections",
    "core_evidence",
    "security_invariants",
    "adoption_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "proposal_id": {
      "const": "kumwe.collection-pagination"
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+-proposal\\.[1-9][0-9]*$",
      "maxLength": 40
    },
    "status": {
      "const": "proposal"
    },
    "authoritative": {
      "const": false
    },
    "audited_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "observed_at"],
      "properties": {
        "repository": {
          "const": "kumwe/app"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "observed_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items_member", "next_cursor_member", "totals"],
      "properties": {
        "items_member": {
          "const": "items"
        },
        "next_cursor_member": {
          "const": "next_cursor"
        },
        "totals": {
          "type": "string",
          "enum": ["never_invented", "declared_per_collection"]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "page_size_minimum",
        "page_size_maximum",
        "page_size_default",
        "cursor_max_length"
      ],
      "properties": {
        "page_size_minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "page_size_maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "page_size_default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "cursor_max_length": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        }
      }
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/collection"
      }
    },
    "core_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "security_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "adoption_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CORE-[A-Z]+-[0-9]{3}$",
        "maxLength": 40
      }
    }
  },
  "$defs": {
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "observed_behavior", "proposed_behavior"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "observed_behavior": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "proposed_behavior": {
          "type": "string",
          "enum": [
            "already_conformant",
            "adopt_cursor_envelope",
            "keep_bounded_window"
          ]
        },
        "core_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    }
  }
}
