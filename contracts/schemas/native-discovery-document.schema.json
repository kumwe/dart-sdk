{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:native-discovery-document:0.1.0",
  "title": "Kumwe native discovery document proposal schema",
  "description": "Proposed closed wire shape of the pre-authentication, non-secret, cacheable discovery document a native client reads before authorization or feature routing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "installation",
    "api",
    "compatibility",
    "authorization",
    "context",
    "limits"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "installation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "display_name"],
      "properties": {
        "reference": {
          "$ref": "#/$defs/identifier"
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_origins", "base_path"],
      "properties": {
        "allowed_origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^https://[a-z0-9]([a-z0-9.-]{0,118}[a-z0-9])?(?::[0-9]{1,5})?$",
            "maxLength": 128
          }
        },
        "base_path": {
          "const": "/api/v1"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_version",
        "openapi_digest",
        "min_client_contract",
        "max_client_contract"
      ],
      "properties": {
        "core_version": {
          "$ref": "#/$defs/version"
        },
        "contract_generation": {
          "$ref": "#/$defs/identifier"
        },
        "openapi_digest": {
          "$ref": "#/$defs/digest"
        },
        "min_client_contract": {
          "$ref": "#/$defs/version"
        },
        "max_client_contract": {
          "$ref": "#/$defs/version"
        },
        "support_url": {
          "type": "string",
          "pattern": "^https://[^\\s]{1,190}$",
          "maxLength": 200
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,63}$",
            "maxLength": 64
          }
        },
        "metadata_path": {
          "type": "string",
          "pattern": "^/api/v1/native/[a-z0-9/-]{1,80}$",
          "maxLength": 96
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_header", "site_required"],
      "properties": {
        "site_header": {
          "const": "Kumwe-Site"
        },
        "site_required": {
          "const": true
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_request_bytes", "max_page_size"],
      "properties": {
        "max_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 1073741824
        },
        "max_page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "localization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_locale"],
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/locale"
        },
        "supported_locales": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/locale"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
        "maxLength": 191
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,190}$",
      "maxLength": 191
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,5}\\.[0-9]{1,5}\\.[0-9]{1,5}(?:-[A-Za-z0-9.-]{1,40})?$",
      "maxLength": 64
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "maxLength": 71
    },
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$",
      "maxLength": 35
    }
  }
}
