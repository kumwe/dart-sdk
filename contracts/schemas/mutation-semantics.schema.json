{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:mutation-semantics:0.1.1",
  "title": "Kumwe mutation semantics proposal schema",
  "description": "Validates the non-authoritative proposal that declares idempotency, replay, precondition and retry semantics per operation family instead of one contradictory shared description.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "proposal_id",
    "proposal_version",
    "status",
    "authoritative",
    "audited_core",
    "purpose",
    "key_header",
    "replayed_header",
    "families",
    "contradictions",
    "core_evidence",
    "security_invariants",
    "adoption_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "proposal_id": {
      "const": "kumwe.mutation-semantics"
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+-proposal\\.[1-9][0-9]*$",
      "maxLength": 40
    },
    "status": {
      "const": "proposal"
    },
    "authoritative": {
      "const": false
    },
    "audited_core": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "observed_at"],
      "properties": {
        "repository": {
          "const": "kumwe/app"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "observed_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        }
      }
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "key_header": {
      "const": "Idempotency-Key"
    },
    "replayed_header": {
      "const": "Idempotency-Replayed"
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/family"
      }
    },
    "contradictions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "core_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "security_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "adoption_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CORE-[A-Z]+-[0-9]{3}$",
        "maxLength": 40
      }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "summary",
        "observed",
        "idempotency",
        "precondition",
        "operation_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "observed": {
          "type": "boolean"
        },
        "idempotency": {
          "$ref": "#/$defs/idempotency"
        },
        "precondition": {
          "type": "string",
          "enum": [
            "if_match_strong_v",
            "if_match_strong",
            "document_version",
            "none",
            "mixed"
          ]
        },
        "operation_status": {
          "type": "boolean"
        },
        "core_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "late_duplicate"],
      "if": {
        "properties": {
          "required": {
            "const": true
          }
        }
      },
      "then": {
        "required": ["required", "late_duplicate", "replay_seconds"]
      },
      "properties": {
        "required": {
          "type": "boolean"
        },
        "replay_seconds": {
          "$ref": "#/$defs/windowSeconds"
        },
        "retention_seconds": {
          "$ref": "#/$defs/windowSeconds"
        },
        "lease_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "late_duplicate": {
          "type": "string",
          "enum": ["refused_window_elapsed", "executed_as_new", "unspecified"]
        },
        "refusals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 96
          }
        }
      }
    },
    "windowSeconds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default"],
      "properties": {
        "default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "minimum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "maximum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        }
      }
    }
  }
}
