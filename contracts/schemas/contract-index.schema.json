{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:contract-index:0.1.1",
  "title": "Kumwe client contract index proposal schema",
  "description": "Validates the non-authoritative SDK capability and profile requirement index.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "proposal_id",
    "proposal_version",
    "status",
    "authoritative",
    "audited_core",
    "profiles",
    "requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "proposal_id": {
      "const": "kumwe.dart-sdk.contract-index"
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+-proposal\\.[1-9][0-9]*$",
      "maxLength": 40
    },
    "status": {
      "const": "proposal"
    },
    "authoritative": {
      "const": false
    },
    "audited_core": {
      "$ref": "#/$defs/auditedCore"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/requirement"
      }
    }
  },
  "$defs": {
    "requirementId": {
      "type": "string",
      "pattern": "^CORE-[A-Z]+-[0-9]{3}$",
      "maxLength": 40
    },
    "profileId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "maxLength": 64
    },
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$",
      "maxLength": 191
    },
    "auditedCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "observed_at"],
      "properties": {
        "repository": {
          "const": "kumwe/app"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "observed_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "required_requirements"],
      "properties": {
        "id": {
          "$ref": "#/$defs/profileId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "required_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capability_id",
        "title",
        "priority",
        "state",
        "contract_plane",
        "required_for",
        "summary",
        "core_evidence",
        "adoption"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/requirementId"
        },
        "capability_id": {
          "$ref": "#/$defs/capabilityId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "priority": {
          "enum": ["P0", "P1", "P2"]
        },
        "state": {
          "enum": ["observed", "partial", "missing", "proposed", "deferred", "blocked"]
        },
        "contract_plane": {
          "enum": ["invariant", "runtime", "profile"]
        },
        "required_for": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/profileId"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 700
        },
        "core_evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^kumwe/app@[0-9a-f]{40}:[A-Za-z0-9_./-]+(?:#[A-Za-z0-9_.:-]+)?$",
            "maxLength": 360
          }
        },
        "adoption": {
          "enum": ["not_required", "core_change_required", "core_decision_required"]
        },
        "depends_on": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        }
      }
    }
  }
}
