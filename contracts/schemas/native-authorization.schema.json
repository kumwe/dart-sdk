{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kumwe:proposal:schema:native-authorization:0.2.0",
  "title": "Kumwe native application authorization proposal schema",
  "description": "Validates the non-authoritative proposal for a user-facing native application authorization profile with authentication-link sign-in, refresh, revocation, logout and web-session handoff semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "proposal_id",
    "proposal_version",
    "status",
    "authoritative",
    "audited_core",
    "purpose",
    "token_response_schema",
    "web_session_response_schema",
    "preferred_profile",
    "profiles",
    "vocabulary",
    "limits",
    "proposed_resources",
    "error_codes",
    "core_evidence",
    "security_invariants",
    "adoption_requirements"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "proposal_id": {
      "const": "kumwe.native-authorization"
    },
    "proposal_version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+-proposal\\.[1-9][0-9]*$",
      "maxLength": 40
    },
    "status": {
      "const": "proposal"
    },
    "authoritative": {
      "const": false
    },
    "audited_core": {
      "$ref": "#/$defs/auditedCore"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "token_response_schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "web_session_response_schema": {
      "type": "string",
      "format": "uri-reference",
      "minLength": 1,
      "maxLength": 200
    },
    "preferred_profile": {
      "$ref": "#/$defs/profileName"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "vocabulary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_challenge_methods",
        "response_types",
        "grant_types",
        "token_types",
        "redirect_kinds",
        "areas"
      ],
      "properties": {
        "code_challenge_methods": {
          "$ref": "#/$defs/tokenList"
        },
        "response_types": {
          "$ref": "#/$defs/tokenList"
        },
        "grant_types": {
          "$ref": "#/$defs/tokenList"
        },
        "token_types": {
          "$ref": "#/$defs/tokenList"
        },
        "redirect_kinds": {
          "$ref": "#/$defs/tokenList"
        },
        "areas": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["administrator", "portal"]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_verifier_min_length",
        "code_verifier_max_length",
        "state_min_bytes",
        "authorization_code_max_length",
        "access_token_max_length",
        "refresh_token_max_length",
        "expires_in_min_seconds",
        "expires_in_max_seconds",
        "scope_max_length",
        "token_response_max_bytes",
        "email_address_max_length",
        "link_ttl_min_seconds",
        "link_ttl_max_seconds",
        "link_manual_code_max_length",
        "web_session_ttl_max_seconds"
      ],
      "properties": {
        "code_verifier_min_length": {
          "type": "integer",
          "minimum": 43,
          "maximum": 128
        },
        "code_verifier_max_length": {
          "type": "integer",
          "minimum": 43,
          "maximum": 128
        },
        "state_min_bytes": {
          "type": "integer",
          "minimum": 16,
          "maximum": 64
        },
        "authorization_code_max_length": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024
        },
        "access_token_max_length": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "refresh_token_max_length": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "expires_in_min_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "expires_in_max_seconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 7776000
        },
        "scope_max_length": {
          "type": "integer",
          "minimum": 16,
          "maximum": 2048
        },
        "token_response_max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65536
        },
        "email_address_max_length": {
          "type": "integer",
          "minimum": 64,
          "maximum": 320
        },
        "link_ttl_min_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 900
        },
        "link_ttl_max_seconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 86400
        },
        "link_manual_code_max_length": {
          "type": "integer",
          "minimum": 8,
          "maximum": 64
        },
        "web_session_ttl_max_seconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 300
        }
      }
    },
    "proposed_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/proposedResource"
      }
    },
    "error_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
        "maxLength": 64
      }
    },
    "core_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "security_invariants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "adoption_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CORE-[A-Z]+-[0-9]{3}$",
        "maxLength": 40
      }
    }
  },
  "$defs": {
    "auditedCore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "observed_at"],
      "properties": {
        "repository": {
          "const": "kumwe/cms"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "maxLength": 40
        },
        "observed_at": {
          "type": "string",
          "format": "date",
          "maxLength": 10
        }
      }
    },
    "profileName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$",
      "maxLength": 64
    },
    "tokenList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
        "maxLength": 64
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "summary", "state"],
      "properties": {
        "id": {
          "$ref": "#/$defs/profileName"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "state": {
          "type": "string",
          "enum": ["observed", "proposed", "rejected"]
        }
      }
    },
    "proposedResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "authentication", "purpose"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "DELETE"]
        },
        "path": {
          "type": "string",
          "pattern": "^/api/v1/native/[a-z0-9/-]{1,80}$",
          "maxLength": 96
        },
        "authentication": {
          "type": "string",
          "enum": ["anonymous", "bearer", "authorization_code", "refresh_token"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
